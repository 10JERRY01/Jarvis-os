# ==============================================================================
# Jarvis OS: Calamares Branding Descriptor
# ==============================================================================

componentName: jarvis

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px, 640px
windowPlacement: center

strings:
    productName:         "Jarvis OS"
    version:             "1.0 (Genesis)"
    shortProductName:    "Jarvis"
    versionedName:       "Jarvis OS 1.0 'Genesis'"
    shortVersionedName:  "Jarvis 1.0"
    bootloaderEntryName: "Jarvis OS"
    productUrl:          "https://jarvis-os.org"
    supportUrl:          "https://jarvis-os.org/support"
    knownIssuesUrl:      "https://jarvis-os.org/issues"
    releaseNotesUrl:     "https://jarvis-os.org/release-notes"

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

style:
   SidebarBackground:    "#07090e"
   SidebarText:          "#f1f5f9"
   SidebarTextSelect:    "#38bdf8"
   SidebarTextHighlight: "#0284c7"
