[Unit]
Description=Jarvis OS Ambient Intelligence Core Daemon
After=network.target sound.target ollama.service
Wants=sound.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jarvis-core
ExecStart=/usr/bin/python3 /opt/jarvis-core/daemon.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
